# ── Conversion Engine — environment configuration ─────────────────────
# Copy to .env and fill in. Per-workspace provider credentials (Resend,
# HubSpot, Cal.com, Africa's Talking, Twilio, per-tenant Anthropic keys)
# are NOT env vars — they are entered in Settings → Provider credentials
# and stored encrypted in the database.

# Core
ENVIRONMENT=development            # development | production
BASE_URL=http://localhost:8000     # public URL (webhooks + unsubscribe links)
APP_SECRET_KEY=change-me-to-a-long-random-string   # CSRF + credential encryption; >=32 chars in production
# APP_SECRET_KEY_OLD=              # previous key, accepted for decryption during rotation
# SETUP_TOKEN=                     # REQUIRED in production: gates the one-shot /setup bootstrap

# Database (SQLite for local dev; Postgres in production)
DATABASE_URL=sqlite+aiosqlite:///./engine.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/engine

# LLM (platform default key; workspaces can override with their own)
ANTHROPIC_API_KEY=sk-ant-...
# Only for identity-linked API keys, which must declare the Anthropic
# workspace a request acts in (ordinary keys ignore this). Find it in the
# Anthropic Console under Settings → Workspaces. Symptom when missing:
# every call fails 400 "anthropic-workspace-id is required".
ANTHROPIC_WORKSPACE_ID=
COMPOSE_MODEL=claude-opus-5
REPLY_MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5

# Self-hosted models over your tailnet (OpenAI-compatible /v1 endpoint:
# Ollama :11434/v1, LM Studio :1234/v1, vLLM/llama.cpp :8000/v1).
# Route any role to it with the "local:" prefix — recommended split: judge
# local, customer-facing compose/reply on Claude:
#   LOCAL_LLM_BASE_URL=http://gpu-box.your-tailnet.ts.net:11434/v1
#   JUDGE_MODEL=local:qwen2.5:14b
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=            # only if your server requires one

# Outbound safety rails
LIVE_MODE=false                    # false → ALL outbound goes to the sink below
SINK_EMAIL=staff-sink@example.com  # required while LIVE_MODE=false
SINK_PHONE=+10000000000            # required while LIVE_MODE=false
MAX_EMAILS_PER_DAY_PER_WORKSPACE=200
MAX_SMS_PER_DAY_PER_WORKSPACE=200
MAX_TOUCHES_PER_PROSPECT=4

# Kill-switch defaults (per-workspace overrides live in the DB)
KILLSWITCH_WINDOW_DAYS=7
KILLSWITCH_OPT_OUT_RATE=0.05
KILLSWITCH_BOUNCE_RATE=0.05
KILLSWITCH_COST_PER_QUALIFIED_LEAD_USD=8.00
KILLSWITCH_MAX_LLM_COST_USD=100.00  # absolute spend ceiling per window (0 disables)

# Worker
RUN_WORKER=true                    # false on the web tier when a dedicated worker runs
WORKER_CONCURRENCY=4               # concurrent job slots (1 on SQLite)
SHUTDOWN_GRACE_SECONDS=20

# Retention (days; 0 disables that purge)
RETENTION_DONE_JOBS_DAYS=30
RETENTION_DEAD_JOBS_DAYS=90
RETENTION_WEBHOOK_EVENTS_DAYS=30
RETENTION_DAILY_COUNTERS_DAYS=90

# LLM tracing (Langfuse) — optional, fail-open. Both keys required to
# activate. Traces carry full prompt/response bodies, which for this system
# means prospect PII; against Langfuse Cloud that data leaves your
# infrastructure. Set LANGFUSE_HOST to a self-hosted instance to avoid that.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0        # fraction of calls traced; lower to cut volume

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=                        # json | text (default: json in production)
SENTRY_DSN=                        # optional error tracking
METRICS_TOKEN=                     # bearer token for GET /metrics (required in production)

# Rate limits (per process)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_RATE_LIMIT_REQUESTS=30
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
